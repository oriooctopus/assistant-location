<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- com.apple.developer.usernotifications.time-sensitive is absent for the same reason as DueSpike:
	     the ASC API cannot enable it on the App ID. Tick "Time Sensitive Notifications" on com.oliverullman.due
	     in the developer portal, then add the key back. -->
</dict>
</plist>
