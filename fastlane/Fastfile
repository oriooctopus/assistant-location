default_platform(:ios)

platform :ios do
  desc "Build signed and upload to TestFlight"
  lane :beta do
    # Write the API key to an absolute path so xcodebuild can use it directly
    # for provisioning-profile creation (the -authenticationKey* flags below).
    key_path = "/tmp/asc_key.p8"
    File.write(key_path, ENV["ASC_KEY_P8"])

    # Sets the key in the global lane context so produce/pilot pick it up.
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
    )

    # Create the App Store Connect app record if it doesn't exist. Bundle id is
    # already registered on the portal (done out-of-band via the API), so skip
    # the dev center step. Idempotent — rescue so re-runs pass once it exists.
    begin
      produce(
        app_name: "Assistant Location OU",
        language: "en-US",
        app_version: "1.0",
        sku: "assistantlocation1",
        bundle_identifier: "com.oliverullman.assistantlocation",
        skip_devcenter: true,
      )
    rescue => e
      UI.message("produce skipped (app likely already exists): #{e.message}")
    end

    cocoapods

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
      xcodeproj: "Overland.xcodeproj",
    )

    build_app(
      workspace: "Overland.xcworkspace",
      scheme: "Overland",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{key_path} " \
              "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
    )
  end
end
