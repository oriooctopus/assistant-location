default_platform(:ios)

PROFILE_NAME = "AssistantLocation AppStore"
APP_ID = "com.oliverullman.assistantlocation"
TEAM_ID = "J66WVM2DTX"

platform :ios do
  desc "Build signed (manual, pre-imported cert+profile) and upload to TestFlight"
  lane :beta do
    cocoapods

    # Monotonic build number so TestFlight never rejects a duplicate/lower one.
    set_info_plist_value(
      path: "GPSLogger/Info.plist",
      key: "CFBundleVersion",
      value: Time.now.strftime("%Y%m%d%H%M"),
    )

    build_app(
      workspace: "Overland.xcworkspace",
      scheme: "Overland",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => PROFILE_NAME },
      },
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "PROVISIONING_PROFILE_SPECIFIER='#{PROFILE_NAME}' " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
    )
  end
end
