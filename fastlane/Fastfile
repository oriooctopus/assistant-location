default_platform(:ios)

PROFILE_NAME = "AssistantLocation AppStore"
APP_ID = "com.oliverullman.assistantlocation"
EXT_ID = "#{APP_ID}.share"
EXT_PROFILE_NAME = "AssistantLocation Share AppStore"
ADHOC_PROFILE_NAME = "AssistantLocation AdHoc"
EXT_ADHOC_PROFILE_NAME = "AssistantLocation Share AdHoc"
CTL_ID = "#{APP_ID}.journalcontrol"
CTL_PROFILE_NAME = "AssistantLocation JournalControl AppStore"
CTL_ADHOC_PROFILE_NAME = "AssistantLocation JournalControl AdHoc"
TEAM_ID = "J66WVM2DTX"
INTERNAL_GROUP = "Internal"
ADHOC_OUTPUT_DIR = "build/adhoc"

platform :ios do
  desc "Build signed (manual, pre-imported cert+profile) and upload to TestFlight"
  lane :beta do
    cocoapods

    api_key = asc_api_key
    ensure_ext_bundle_id

    [[EXT_ID, EXT_PROFILE_NAME], [CTL_ID, CTL_PROFILE_NAME]].each do |identifier, name|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: identifier,
        provisioning_name: name,
        team_id: TEAM_ID,
        readonly: false,
      )
    end

    build_number = stamp_build_number

    build_app(
      workspace: "Overland.xcworkspace",
      scheme: "Overland",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_ID => PROFILE_NAME,
          EXT_ID => EXT_PROFILE_NAME,
          CTL_ID => CTL_PROFILE_NAME,
        },
      },
      # PROVISIONING_PROFILE_SPECIFIER is deliberately NOT passed here: an
      # xcargs value applies to every target, which would hand the app's profile
      # to the extension. Each target carries its own specifier in the project.
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
    )

    # A build that belongs to no beta group is invisible to every tester, even
    # once it processes to VALID. `upload_to_testflight` only assigns groups
    # when it waits for processing, and waiting costs 10-20 macOS runner
    # minutes per build, so the group is assigned here instead: the build
    # resource shows up in the API within a minute or two of the upload, long
    # before processing finishes, and a group assigned while it is still
    # PROCESSING takes effect the moment it goes VALID.
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    group = app.get_beta_groups.find { |g| g.name == INTERNAL_GROUP }
    UI.user_error!("No beta group named #{INTERNAL_GROUP.inspect} on #{APP_ID}") unless group

    build = nil
    30.times do
      build = Spaceship::ConnectAPI::Build.all(
        app_id: app.id, build_number: build_number,
      ).first
      break if build
      sleep(20)
    end
    UI.user_error!("Build #{build_number} never appeared in App Store Connect") unless build

    build.add_beta_groups(beta_groups: [group])
    UI.success("Build #{build_number} assigned to beta group #{INTERNAL_GROUP.inspect}")
  end

  desc "Build an ad-hoc signed ipa for over-the-air install on the registered device"
  lane :adhoc do
    cocoapods

    api_key = asc_api_key
    ensure_ext_bundle_id

    # The ad hoc profiles already exist in App Store Connect; these calls find
    # and download them. readonly stays false so a newly registered device can
    # be folded in by regenerating the profile.
    [[APP_ID, ADHOC_PROFILE_NAME], [EXT_ID, EXT_ADHOC_PROFILE_NAME],
     [CTL_ID, CTL_ADHOC_PROFILE_NAME]].each do |identifier, name|
      get_provisioning_profile(
        api_key: api_key,
        adhoc: true,
        app_identifier: identifier,
        provisioning_name: name,
        team_id: TEAM_ID,
        readonly: false,
      )
    end

    stamp_build_number

    # export_options only governs the export step; the ARCHIVE step signs with
    # the PROVISIONING_PROFILE_SPECIFIER committed in the pbxproj, which names
    # the App Store profiles and is not installed on this runner. Rewrite the
    # specifier per target — xcargs cannot do this, because one xcargs value
    # applies to every target and would hand the app's profile to the extension.
    # This edits the pbxproj on the runner only; it is never committed.
    {
      "Overland" => ADHOC_PROFILE_NAME,
      "ShareToDesktop" => EXT_ADHOC_PROFILE_NAME,
      "JournalControl" => CTL_ADHOC_PROFILE_NAME,
    }.each do |target, profile|
      update_code_signing_settings(
        path: "Overland.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile,
      )
    end

    build_app(
      workspace: "Overland.xcworkspace",
      scheme: "Overland",
      export_method: "ad-hoc",
      output_directory: ADHOC_OUTPUT_DIR,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_ID => ADHOC_PROFILE_NAME,
          EXT_ID => EXT_ADHOC_PROFILE_NAME,
          CTL_ID => CTL_ADHOC_PROFILE_NAME,
        },
      },
      # See the note in `beta`: an xcargs specifier would apply to every target.
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
    )

    UI.success("Ad hoc ipa: #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
    )
  end

  # The share extension and the journal Control are each a second bundle id
  # and need their own App ID plus their own provisioning profile. They get a
  # Developer Portal identifier only — an extension must never get an App
  # Store Connect app record.
  #
  # This talks to Spaceship directly rather than using `produce`, which still
  # authenticates through the legacy Apple ID login and so asks for a password
  # the runner does not have; the App Store Connect API key works here.
  private_lane :ensure_ext_bundle_id do
    Spaceship::ConnectAPI.auth(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: ENV["ASC_KEY_P8"],
    )
    [[EXT_ID, "Assistant Location Share"],
     [CTL_ID, "Assistant Location Journal Control"]].each do |identifier, name|
      existing = Spaceship::ConnectAPI::BundleId.find(identifier)
      if existing
        UI.message("Bundle id #{identifier} is already registered")
      else
        Spaceship::ConnectAPI::BundleId.create(
          name: name,
          identifier: identifier,
          platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
        )
        UI.success("Registered bundle id #{identifier}")
      end
    end
  end

  # Returns the build number it stamped.
  private_lane :stamp_build_number do
    # Monotonic build number so TestFlight never rejects a duplicate/lower one.
    # Every extension MUST carry the same CFBundleVersion (and the same
    # CFBundleShortVersionString, which all three plists pin to 1.3) as the
    # app, or the upload fails validation.
    build_number = Time.now.strftime("%Y%m%d%H%M")
    ["GPSLogger/Info.plist", "ShareToDesktop/Info.plist", "JournalControl/Info.plist"].each do |plist|
      set_info_plist_value(path: plist, key: "CFBundleVersion", value: build_number)
    end

    # Build identity on the home screen itself: every build has carried version
    # 1.3, so without this the icon label cannot distinguish installs. Derived
    # from build_number so it cannot go stale ("T0802-0117" == 202608020117),
    # and kept to 10 chars so iOS does not truncate it under the icon.
    display_name = "T#{build_number[4, 4]}-#{build_number[8, 4]}"
    set_info_plist_value(path: "GPSLogger/Info.plist",
                         key: "CFBundleDisplayName",
                         value: display_name)
    UI.success("Home-screen display name for this build: #{display_name}")

    build_number
  end
end
