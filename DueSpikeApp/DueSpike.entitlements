<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- com.apple.developer.usernotifications.time-sensitive is deliberately
	     absent: the ASC API cannot enable that capability on the App ID, and
	     without it in the profile the build fails (run 39265616250). Add the
	     key back after ticking "Time Sensitive Notifications" on the App ID
	     in the developer portal. -->
</dict>
</plist>
