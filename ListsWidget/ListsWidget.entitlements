<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same keychain group as ListsApp/Lists.entitlements: the widget reads the snapshot item the
	     app writes. The ad-hoc profile for this bundle id allows J66WVM2DTX.*. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.oliverullman.lists</string>
	</array>
</dict>
</plist>
