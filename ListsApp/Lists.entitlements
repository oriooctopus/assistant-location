<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same group as ListsWidget/ListsWidget.entitlements: the app writes state.json into this
	     container and the widget reads it. The group must be registered in the developer portal
	     and attached to BOTH App IDs (the fastlane API cannot do that step, see lists_adhoc). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.oliverullman.lists</string>
	</array>
</dict>
</plist>
