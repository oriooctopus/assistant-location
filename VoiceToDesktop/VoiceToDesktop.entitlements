<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The photo handoff is written to the SHARE extension's keychain group
	     (Overland.entitlements lists it, so the app can read and delete);
	     this extension compiles the same ShareViewController.m and reuses
	     that group instead of adding a second one to the app. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.oliverullman.assistantlocation.share</string>
	</array>
</dict>
</plist>
